{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fu9zhou/finish-bit/schemas/operation-v1.schema.json",
  "title": "FinishBit Operation definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "summary", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$" },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "options": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package"],
        "properties": { "package": { "type": "string", "minLength": 1 } }
      }
    },
    "source": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "integer", "boolean", "strings"] },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": {}
      }
    }
  }
}
